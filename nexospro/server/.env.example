PORT=4700
# URI base de MongoDB sin nombre de base de datos (p.ej. mongodb://localhost:27017).
# En la nube: mongodb+srv://usuario:pass@cluster.mongodb.net
MONGODB_URI_BASE=mongodb://localhost:27017
# Nombre de la base de datos de plataforma (cuentas y tenants).
BD_PLATAFORMA=filanex_plataforma
# Prefijo de las bases de datos de negocio: filanex_<slug>.
PREFIJO_BD=filanex_

# Secreto para firmar tokens JWT (minimo 32 caracteres).
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Clave maestra para cifrar secretos (contraseña del certificado VeriFactu).
CLAVE_CERTS=cambia_esto_por_otra_clave_larga_y_aleatoria

# Variables para almacenamiento en la nube (S3-compatible). Si no se
# configuran, el servidor usa el disco local (modo on-premise).
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=filanex

# Origen permitido del frontend (CORS). En produccion: https://app.filanex.es
FRONTEND_URL=http://localhost:4700

GEMINI_API_KEY=
# Modelo de IA (OCR de compras y dictado de citas). Google retira los modelos
# antiguos sin avisar: si empieza a fallar, ejecuta
# `node scripts/probar-gemini.mjs` para ver los disponibles y actualiza aquí.
GEMINI_MODEL=gemini-3.6-flash

# Identidad del productor del SIF (FILA TECNICA)
SIF_NOMBRE_RAZON=FILA TECNICA SL
SIF_NIF=B75418350
SIF_ID=NP
SIF_VERSION=0.1.0
SIF_NUM_INSTALACION=1

# Remisión AEAT (sin certificado, los registros quedan pendientes de envío)
AEAT_ENTORNO=pruebas
AEAT_CERT_PFX=
AEAT_CERT_PASS=
