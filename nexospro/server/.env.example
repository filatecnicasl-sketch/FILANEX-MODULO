PORT=4700
# URI base de MongoDB sin nombre de base de datos (p.ej. mongodb://localhost:27017).
# En la nube: mongodb+srv://usuario:pass@cluster.mongodb.net
MONGODB_URI_BASE=mongodb://localhost:27017
# Nombre de la base de datos de plataforma (cuentas y tenants).
BD_PLATAFORMA=filanex_plataforma
# Prefijo de las bases de datos de negocio: filanex_<slug>.
PREFIJO_BD=filanex_

# Secreto para firmar tokens JWT (minimo 32 caracteres).
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Clave maestra para cifrar secretos (contraseña del certificado VeriFactu).
CLAVE_CERTS=cambia_esto_por_otra_clave_larga_y_aleatoria

# Variables para almacenamiento en la nube (S3-compatible). Si no se
# configuran, el servidor usa el disco local (modo on-premise).
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=filanex

# Origen permitido del frontend (CORS). En produccion: https://app.filanex.es
FRONTEND_URL=http://localhost:4700
# URL pública del backend para enlaces temporales enviados a clientes.
PUBLIC_API_URL=http://localhost:4700

# Copias de seguridad automáticas: hora diaria (formato HH:MM, hora del
# servidor) y cuántas copias automáticas se conservan por empresa. Las copias
# manuales nunca se borran solas. Con R2/S3 configurado, las copias se
# guardan también fuera del servidor.
BACKUP_HORA=03:30
BACKUP_RETENER=14
# Carpeta donde guardar las copias de la app (automáticas y manuales). Puede
# ser cualquier carpeta del servidor: un disco externo, un NAS montado, etc.
# Si no se define, se usa la carpeta backups/ dentro del servidor.
# BACKUP_DIR=/opt/filanex/backups/app
# Carpeta y retención en días de la copia completa del servidor (mongodump).
# BACKUP_SERVIDOR_DIR=/opt/filanex/backups/mongo
# BACKUP_SERVIDOR_RETENER=7
# BACKUP_DESACTIVADO=true  # para desactivar el programador

GEMINI_API_KEY=
# Modelo de IA (OCR de compras y dictado de citas). Google retira los modelos
# antiguos sin avisar: si empieza a fallar, ejecuta
# `node scripts/probar-gemini.mjs` para ver los disponibles y actualiza aquí.
GEMINI_MODEL=gemini-3.6-flash

# Proveedor de IA: auto (Gemini y, si Google bloquea el servidor, OpenAI),
# gemini u openai. Google rechaza las claves de AI Studio usadas desde
# centros de datos con "User location is not supported": en servidores
# conviene configurar OPENAI_API_KEY o un proxy propio en GEMINI_BASE_URL.
IA_PROVEEDOR=auto
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Vertex AI (Google Cloud): la vía definitiva para servidores. Autentica con
# la cuenta de servicio, no por ubicación, así que no sufre el bloqueo de
# AI Studio. Requiere proyecto con facturación y API de Vertex AI habilitada.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=europe-west1
VERTEX_MODEL=
# Ruta al archivo JSON de la cuenta de servicio (rol: Usuario de Vertex AI).
GOOGLE_APPLICATION_CREDENTIALS=

# WhatsApp Business Platform oficial (Meta Embedded Signup).
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
CLAVE_WHATSAPP=cambia_esto_por_una_clave_larga_y_aleatoria
WHATSAPP_GRAPH_VERSION=v23.0

# Identidad del productor del SIF (FILA TECNICA)
SIF_NOMBRE_RAZON=FILA TECNICA SL
SIF_NIF=B75418350
SIF_ID=NP
SIF_VERSION=0.1.0
SIF_NUM_INSTALACION=1

# Remisión AEAT (sin certificado, los registros quedan pendientes de envío)
AEAT_ENTORNO=pruebas
AEAT_CERT_PFX=
AEAT_CERT_PASS=
